# Optional but strongly recommended. A free GitHub Personal Access Token
# (classic, NO scopes needed for public data) lifts the Search API limit from
# 10/min (unauthenticated) to ~30/min, and Core from 60/hr to 5,000/hr.
# Create one at https://github.com/settings/tokens
GITHUB_TOKEN=

# Production datastore. When DATABASE_URL is set, the app uses Postgres (Neon);
# otherwise it falls back to a local SQLite file (.data/firstmerge.db) for dev.
# The Vercel↔Neon integration injects this automatically in production; pull it
# locally with `vercel env pull` if you want to test the Postgres path.
DATABASE_URL=

# Authorizes the unattended ingest cron. Set this in Vercel — Vercel Cron then
# sends `Authorization: Bearer $CRON_SECRET` to /api/ingest automatically.
# INGEST_SECRET is an accepted alias for manual/curl triggers. Leave unset in
# local dev (the dashboard button works same-origin without it).
CRON_SECRET=
# INGEST_SECRET=

# Optional. If set, the app uses Redis for caching; otherwise it falls back to
# an in-memory cache (zero setup, stays free). e.g. redis://localhost:6379
REDIS_URL=

# Freshness / revalidation (optional). Each ingest re-checks up to N cached
# issues that haven't been verified in the last H hours, hiding any that have
# been closed or merged since.
REVALIDATE_BUDGET=150
REVALIDATE_AFTER_HOURS=6

# Ingest cadence bounds (optional). Each cron tick does (languages × pages)
# Search-API calls — keep the product well under ~25 to stay under ~30/min.
# INGEST_LANGUAGES=TypeScript,JavaScript,Python,Go,Rust,Java
# INGEST_PAGES=1
# INGEST_PER_PAGE=40

# Public links shown in the UI. Swap for your own handles.
NEXT_PUBLIC_BMC_USERNAME=your-username
NEXT_PUBLIC_REPO_URL=https://github.com/your-username/firstmerge
