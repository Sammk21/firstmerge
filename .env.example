# Optional but strongly recommended. A free GitHub Personal Access Token
# (classic, NO scopes needed for public data) lifts the search rate limit
# from 10/min to 5,000/hr. Create one at https://github.com/settings/tokens
GITHUB_TOKEN=

# Optional. If set, the app uses Redis for caching; otherwise it falls back to
# an in-memory cache (zero setup, stays free). e.g. redis://localhost:6379
REDIS_URL=

# Freshness / revalidation (optional). Each ingest re-checks up to N cached
# issues that haven't been verified in the last H hours, hiding any that have
# been closed or merged since.
REVALIDATE_BUDGET=150
REVALIDATE_AFTER_HOURS=6

# Public links shown in the UI. Swap for your own handles.
NEXT_PUBLIC_BMC_USERNAME=your-username
NEXT_PUBLIC_REPO_URL=https://github.com/your-username/firstmerge
